                        <Textbox Name="OData__ModerationStatus">
                          <rd:DefaultName>OData__ModerationStatus</rd:DefaultName>
                          <CanGrow>true</CanGrow>
                          <KeepTogether>true</KeepTogether>
                          <Paragraphs>
                            <Paragraph>
                              <TextRuns>
                                <TextRun>
                                  <Value>=Switch(
    Fields!OData__ModerationStatus.Value = 0, "Published",
    Fields!OData__ModerationStatus.Value = 1, "Rejected",
    Fields!OData__ModerationStatus.Value = 2, "Pending",
    Fields!OData__ModerationStatus.Value = 3, "Draft",
    True, "Unknown"
)</Value>
                                  <Style>
                                    <FontFamily>Arial</FontFamily>
                                  </Style>
                                </TextRun>
