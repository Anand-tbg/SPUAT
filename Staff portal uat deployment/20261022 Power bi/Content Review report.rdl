  <DataSets>
    <DataSet Name="SitePages">
      <Query>
        <DataSourceName>PowerQuery</DataSourceName>
        <CommandText>{"QueryName":"Site Pages","MashupDocument":"section Section1;\r\nshared #\"Site Pages\" = let\n    SiteUrl = \"https://ttponline.sharepoint.com/sites/staffportal-dev\",\n    ListName = \"Site Pages\",\n    ApiUrl = SiteUrl &amp; \"/_api/web/lists/getbytitle('\" &amp; ListName &amp; \"')/items?$select=Title,OData__ModerationStatus,PublishedDate,FileLeafRef,FileRef,FileDirRef,FSObjType,SPSOwnerDepartment/Id,SPSOwnerDepartment/Title,Author/Id,Author/Title,Author/EMail,Editor/Id,Editor/Title,Editor/EMail&amp;$expand=SPSOwnerDepartment,Author,Editor&amp;$top=5000\",\n    GetPage = (url as text) =&gt;\n        let\n            Source = Json.Document(Web.Contents(url, [Headers=[Accept=\"application/json;odata=nometadata\"]])),\n            Items = Source[value],\n            NextLink = try Source[odata.nextLink] otherwise null\n        in\n            [Items = Items, Next = NextLink],\n    FirstPage = GetPage(ApiUrl),\n    AllPages =\n        List.Generate(\n            () =&gt; FirstPage,\n            each _ &lt;&gt; null,\n            each if _[Next] &lt;&gt; null\n                 then GetPage(SiteUrl &amp; Text.AfterDelimiter(_[Next], SiteUrl))\n                 else null,\n            each _[Items]\n        ),\n    AllItems = List.Combine(AllPages),\n    Table = Table.FromList(AllItems, Splitter.SplitByNothing(), null, null, ExtraValues.Error),\n    FirstRecord = if List.Count(AllItems) &gt; 0 then List.Distinct(List.Combine(List.Transform(AllItems, Record.FieldNames))) else {},\n    Expanded = Table.ExpandRecordColumn(Table, \"Column1\", FirstRecord),\n    FilesOnly = Table.SelectRows(Expanded, each Record.HasFields(_, \"FSObjType\") and [FSObjType] = 0 and not Text.Contains([FileDirRef], \"Templates\") and not Text.Contains([FileDirRef], \"SP Vine\")),\n    ExpandedEditor = if List.Contains(Table.ColumnNames(FilesOnly), \"Editor\") then Table.ExpandRecordColumn(FilesOnly, \"Editor\", {\"Title\"}, {\"EditorName\"}) else Table.AddColumn(FilesOnly, \"EditorName\", each null, type text),\n    ExpandedDepartment = if List.Contains(Table.ColumnNames(ExpandedEditor), \"SPSOwnerDepartment\") then Table.ExpandRecordColumn(ExpandedEditor, \"SPSOwnerDepartment\", {\"Title\"}, {\"OwnerDepartment\"}) else Table.AddColumn(ExpandedEditor, \"OwnerDepartment\", each null, type text)\nin\n    ExpandedDepartment;\r\n","ConnectionOverrides":[{"Path":"https://ttponline.sharepoint.com/sites/staffportal-dev/_api/web/lists/getbytitle('Site%20Pages')/items?$expand=File&amp;$select=File,Title,Id","Kind":"Web","Provider":"DmtsFabric","AuthenticationKind":null,"EnvironmentName":null,"ApiName":null,"ConnectionName":"{\"ClusterId\":\"b155cb50-ec8f-44e0-9a74-0b1eaa4c9fa0\",\"DatasourceId\":\"dad09519-25dc-48fa-8363-f38107d57e44\"}","PrivacyGroup":"Organizational","CredentialDetails":{},"Audience":null,"ConnectionParameters":{}}],"GatewayObjectId":null,"ParameterDefinitions":[]}</CommandText>
      </Query>
      <Fields>
