                      <CellContents>
                        <Textbox Name="PublishedDate">
                          <rd:DefaultName>PublishedDate</rd:DefaultName>
                          <CanGrow>true</CanGrow>
                          <KeepTogether>true</KeepTogether>
                          <Paragraphs>
                            <Paragraph>
                              <TextRuns>
                                <TextRun>
                                  <Value>=IIF(
    IsNothing(Fields!PublishedDate.Value),
    Nothing,
    Format(DateAdd("h", 8, Fields!PublishedDate.Value), "dd/MM/yyyy")
)</Value>
                                  <Style>
                                    <FontFamily>Arial</FontFamily>
                                  </Style>
                                </TextRun>
                              </TextRuns>
                              <Style />
                            </Paragraph>
