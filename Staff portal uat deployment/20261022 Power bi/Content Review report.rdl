    <DataSet Name="Departments">
      <Query>
        <DataSourceName>PowerQuery</DataSourceName>
        <CommandText>{"QueryName":"Departments","MashupDocument":"section Section1;\r\nshared Departments = let\n    Source = SharePoint.Tables(\"https://ttponline.sharepoint.com/sites/staffportal-dev/\", [Implementation = \"2.0\", ViewMode = \"Default\"]),\n    #\"Navigation 1\" = Source{[Id = \"123b20e7-1ffe-4638-83d2-2a0fe6419827\"]}[Items],\n    ColumnNames = Table.ColumnNames(#\"Navigation 1\"),\n    // create a new record with only Title and SPSDepartmentName set\n    AllRowRecord = Record.FromList(\n        List.Transform(ColumnNames, (c) =&gt; if c = \"Department Code\" then \"All\" else if c = \"Department Name\" then \"All\" else null),\n        ColumnNames\n    ),\n    AddAllRow = Table.InsertRows(#\"Navigation 1\", 0, {AllRowRecord}),\n  #\"Removed columns\" = Table.RemoveColumns(AddAllRow, {\"Edit\", \"Department Number\", \"Created\", \"ID\"})\nin\n    #\"Removed columns\";\r\n","ConnectionOverrides":[{"Path":"https://ttponline.sharepoint.com/sites/staffportal-dev/","Kind":"SharePoint","Provider":"DmtsFabric","AuthenticationKind":null,"EnvironmentName":null,"ApiName":null,"ConnectionName":"{\"ClusterId\":\"b155cb50-ec8f-44e0-9a74-0b1eaa4c9fa0\",\"DatasourceId\":\"be71d4a2-07a7-47c0-a031-9d93d4175990\"}","PrivacyGroup":"None","CredentialDetails":{},"Audience":null,"ConnectionParameters":{}}],"GatewayObjectId":null,"ParameterDefinitions":[]}</CommandText>
      </Query>
      <Fields>
        <Field Name="DepartmentCode">
          <DataField>Department Code</DataField>
        </Field>
        <Field Name="DepartmentName">
          <DataField>Department Name</DataField>
        </Field>
        <Field Name="Acronym">
          <DataField>Acronym</DataField>
        </Field>
        <Field Name="CSScolour">
          <DataField>CSS colour</DataField>
        </Field>
      </Fields>
    </DataSet>
  </DataSets>
